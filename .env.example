# Copy this file to .env.local and fill in the values from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: phone alerts (Web Push). Generate a P-256 key pair; the public key must match lib/push-client.js.
# Server-side only. Never commit real values and never use NEXT_PUBLIC_ for these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any long random string; use the same value inside supabase/010_push.sql
PUSH_SECRET=
